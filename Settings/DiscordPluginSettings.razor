@inherits PluginSettingsComponent
@implements IDisposable

@* Página do plugin no manager (Loja > Discord > Configurar): a conta e o app do Developer Portal, uma vez só para
   todos os widgets do Discord. Enquanto a página está aberta ela segura a sessão, para mostrar o estado e autorizar
   mesmo sem nenhum widget do Discord no layout. *@
<AccountPanel Session="_session" />

@code {
    private readonly DiscordSession _session = DiscordButtonInstance.SessionOverride ?? DiscordSession.Shared;
    private IDisposable? _lease;

    protected override void OnInitialized()
    {
        _session.UseLogger(Host.LoggerFactory);
        _lease = _session.Acquire();
    }

    public void Dispose() => _lease?.Dispose();
}
